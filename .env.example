# Copy this file to .env and fill in your real keys.
# .env is gitignored, so your keys stay out of version control.

# OmniRoute dashboard key — http://localhost:20128/dashboard (top right)
OMNIROUTE_KEY=your-dashboard-key

# Higgsfield API key — from your Higgsfield account
HIGGSFIELD_KEY=your-higgsfield-key

# Optional overrides (defaults shown)
# OMNIROUTE_URL=http://localhost:20128/v1
# HIGGSFIELD_URL=https://api.higgsfield.ai/v1

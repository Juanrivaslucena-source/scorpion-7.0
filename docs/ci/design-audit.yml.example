name: Design Audit

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]

jobs:
  design-audit:
    name: Design Audit
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'

      - name: Install dependencies (if any)
        run: npm ci

      - name: Run design audit
        run: npm run design:audit
        env:
          DESIGN_AUDIT_BASE_URL: http://localhost:3000
          DESIGN_AUDIT_ROUTES: /,/about,/contact,/dashboard,/settings,/profile
          DESIGN_AUDIT_TIMEOUT: 60000

      - name: Upload audit report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: design-audit-report
          path: design-report/
          retention-days: 7

  verify:
    name: Verify
    runs-on: ubuntu-latest
    needs: design-audit
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'

      - name: Install dependencies (if any)
        run: npm ci

      - name: Run tests
        run: npm test

      - name: Run design audit
        run: npm run design:audit
        env:
          DESIGN_AUDIT_BASE_URL: http://localhost:3000
          DESIGN_AUDIT_ROUTES: /,/about,/contact,/dashboard,/settings,/profile

# To enable this workflow:
# 1. Copy this file to .github/workflows/design-audit.yml
# 2. Uncomment the following lines:
#
# on:
#   push:
#     branches: [main, develop]
#   pull_request:
#     branches: [main, develop]
#
# 3. Adjust the DESIGN_AUDIT_BASE_URL to your application's URL
# 4. Adjust DESIGN_AUDIT_ROUTES to your application's routes
# 5. Commit and push to your repository

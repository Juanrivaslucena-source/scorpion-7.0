{
  "name": "scorpion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Scorpion \u2014 website builder, flagship showcase, content engine, and dropship pipeline.",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:unit": "node --test test/dropship.test.mjs",
    "test:audit": "node --test test/audit.test.mjs",
    "research": "node dropship/research.mjs score dropship/products/_candidates.json",
    "page": "node dropship/build-page.mjs",
    "kit": "node dropship/content-kit.mjs",
    "audit": "node dropship/audit.mjs --all",
    "clips": "node content/render.mjs",
    "verify": "npm run test && npm run audit && npm run brain:review -- --strict",
    "brain": "node brain/brain.mjs",
    "brain:recall": "node brain/brain.mjs recall",
    "brain:review": "node brain/brain.mjs review",
    "brain:brief": "node brain/brain.mjs brief --write",
    "brain:stats": "node brain/brain.mjs stats",
    "test:brain": "node --test test/brain.test.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.49.0"
  },
  "dependencies": {}
}
